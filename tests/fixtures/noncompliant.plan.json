          "create"
        ],
        "after": {
          "name": "stdemo",
          "min_tls_version": "TLS1_0",
          "https_traffic_only_enabled": false,
          "public_network_access_enabled": true,
          "allow_nested_items_to_be_public": true,
          "tags": {
            "owner": "platform-team",
            "environment": "prod",
            "data_classification": "moderate"
          }
        }
      }
    },
    {
      "address": "azurerm_key_vault.weak",
